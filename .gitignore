# macOS Finder cruft
.DS_Store
**/.DS_Store

# Local credential/state dir (env-var-first; fallbacks under .state/ should never be committed)
.state/
**/.state/

# Editor scratch / backup files
*~
*.swp

# Logs
*.log

# Generated Organization Skills upload (node scripts/build-org-bundle.mjs).
# Never committed: the plugin skills are the source of truth, this is a build
# product, and a checked-in copy is one more thing that can go stale.
dist/
