{
  "PreCompact": [
    {
      "matcher": "*",
      "hooks": [
        {
          "type": "command",
          "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/precompact-snapshot.sh\" 2>/dev/null || true",
          "timeout": 10,
          "statusMessage": "Snapshotting state before compaction..."
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "matcher": "*",
      "hooks": [
        {
          "type": "command",
          "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/post-compaction-notice.sh\" 2>/dev/null || true",
          "timeout": 5
        }
      ]
    }
  ]
}
