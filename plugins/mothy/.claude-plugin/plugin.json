{
  "name": "mothy",
  "version": "0.26.1",
  "description": "Moth+Flame team agent \u2014 briefs, decks, intel search, Google Workspace in-place edits, onboarding, and the AI-native product process (idea-intake, pr-faq, prd, evals, process-navigator). Sign in with your @mothandflamevr.com Google account.",
  "author": {
    "name": "Moth+Flame",
    "email": "rich@mothandflamevr.com"
  },
  "homepage": "https://github.com/moth-flame/mothy-plugins",
  "keywords": [
    "mothy",
    "intel",
    "briefs",
    "decks",
    "crm",
    "google-workspace",
    "video",
    "article",
    "demo",
    "compaction",
    "pr-faq",
    "prd",
    "idea-intake",
    "process-navigator",
    "product-process",
    "evals"
  ],
  "hooks": {
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/precompact-snapshot.sh\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Snapshotting state before compaction..."
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/auto-park.mjs\" 2>/dev/null || true",
            "timeout": 100,
            "statusMessage": "Capturing what was going on..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/post-compaction-notice.sh\" 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/post-compaction-notice.sh\" 2>/dev/null || true",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-mc-policy.mjs\" 2>/dev/null || true",
            "timeout": 5,
            "statusMessage": "Loading question-widget policy..."
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/arm-push-gate.mjs\" 2>/dev/null || true",
            "timeout": 25,
            "statusMessage": "Checking this repo's pre-push gate..."
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-plugin-freshness.mjs\" 2>/dev/null || true",
            "timeout": 5,
            "statusMessage": "Checking plugin freshness..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-rd-nudge.sh\" 2>/dev/null || true",
            "timeout": 5,
            "statusMessage": "Loading R&D process nudge..."
          }
        ]
      }
    ]
  }
}
